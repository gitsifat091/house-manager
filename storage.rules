rules_version = '2';

// House Manager — Cloud Storage security rules.
//
// The app does not use Cloud Storage. Profile pictures are base64-encoded
// into the users document instead (see StorageService), so nothing should be
// reading or writing a bucket. This denies everything, which is the correct
// posture for an unused service and closes the default template rules.
//
// If you move profile pictures to Storage — which you should, base64 in a
// document is expensive to read — replace this with a rule scoped to the
// owner, for example:
//
//   match /profilePictures/{userId}/{fileName} {
//     allow read: if request.auth != null;
//     allow write: if request.auth != null
//       && request.auth.uid == userId
//       && request.resource.size < 2 * 1024 * 1024
//       && request.resource.contentType.matches('image/.*');
//   }
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
