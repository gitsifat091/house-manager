          "fileOutput": "android/app/google-services.json"
        }
      },
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "house-manager-bf593",
          "configurations": {
            "android": "1:298634740911:android:43202ac2b431885c8f805a",
            "ios": "1:298634740911:ios:b6c0582f9e677ec38f805a",
            "macos": "1:298634740911:ios:b6c0582f9e677ec38f805a",
            "web": "1:298634740911:web:efdd9bce760a71e98f805a",
